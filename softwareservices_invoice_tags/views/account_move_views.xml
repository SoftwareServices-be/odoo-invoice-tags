<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Invoice / bill form: add tags in the header (left) group. -->
    <record id="view_move_form_softwareservices_tags" model="ir.ui.view">
        <field name="name">account.move.form.softwareservices.tags</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="softwareservices_tag_ids"
                       widget="many2many_tags"
                       options="{'color_field': 'color'}"
                       placeholder="Tags"/>
            </xpath>
        </field>
    </record>

    <!-- Customer invoices list. -->
    <record id="view_out_invoice_tree_softwareservices_tags" model="ir.ui.view">
        <field name="name">account.out.invoice.tree.softwareservices.tags</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="softwareservices_tag_ids"
                       widget="many2many_tags"
                       options="{'color_field': 'color'}"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Vendor bills list. -->
    <record id="view_in_invoice_bill_tree_softwareservices_tags" model="ir.ui.view">
        <field name="name">account.in.invoice.bill.tree.softwareservices.tags</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="softwareservices_tag_ids"
                       widget="many2many_tags"
                       options="{'color_field': 'color'}"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Invoice/bill search view: filter by tag. -->
    <record id="view_account_invoice_filter_softwareservices_tags" model="ir.ui.view">
        <field name="name">account.invoice.filter.softwareservices.tags</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="softwareservices_tag_ids" string="Tag"/>
            </xpath>
        </field>
    </record>

</odoo>
